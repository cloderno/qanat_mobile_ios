// Скопируйте в Config/Secrets.xcconfig и заполните. Файл в git не попадает.

// Адрес сервера; для локального сервера с симулятора: http:/$()/localhost:8000/api/v1/
// QANAT_BASE_URL = https:/$()/qm.e-vko.kz/api/v1/

// ID и токен приложения из Wearables Developer Center. Без них приложение собирается, очки работают
// только в режиме разработчика Meta AI.
META_APP_ID = ...
CLIENT_TOKEN = ...

// Apple Developer Team ID — нужен и для подписи, и Meta SDK для проверки приложения.
DEVELOPMENT_TEAM = ...
