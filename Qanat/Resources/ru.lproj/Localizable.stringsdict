<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>chat_photos</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@value@</string>
    <key>value</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>d</string>
      <key>one</key>
      <string>%d снимок</string>
      <key>few</key>
      <string>%d снимка</string>
      <key>many</key>
      <string>%d снимков</string>
      <key>other</key>
      <string>%d снимка</string>
    </dict>
  </dict>
  <key>chat_step_sources</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%2$#@value@</string>
    <key>value</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>d</string>
      <key>one</key>
      <string>%1$@ · %2$d источник</string>
      <key>few</key>
      <string>%1$@ · %2$d источника</string>
      <key>many</key>
      <string>%1$@ · %2$d источников</string>
      <key>other</key>
      <string>%1$@ · %2$d источника</string>
    </dict>
  </dict>
  <key>gallery_delete_confirm_title</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@value@</string>
    <key>value</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>d</string>
      <key>one</key>
      <string>Удалить %d файл?</string>
      <key>few</key>
      <string>Удалить %d файла?</string>
      <key>many</key>
      <string>Удалить %d файлов?</string>
      <key>other</key>
      <string>Удалить %d файла?</string>
    </dict>
  </dict>
  <key>gallery_delete_dialog_title</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@value@</string>
    <key>value</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>d</string>
      <key>one</key>
      <string>Удалить %d фото и видео?</string>
      <key>few</key>
      <string>Удалить %d фото и видео?</string>
      <key>many</key>
      <string>Удалить %d фото и видео?</string>
      <key>other</key>
      <string>Удалить %d фото и видео?</string>
    </dict>
  </dict>
  <key>gallery_deleted</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@value@</string>
    <key>value</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>d</string>
      <key>one</key>
      <string>Удалено %d</string>
      <key>few</key>
      <string>Удалено %d</string>
      <key>many</key>
      <string>Удалено %d</string>
      <key>other</key>
      <string>Удалено %d</string>
    </dict>
  </dict>
</dict>
</plist>
