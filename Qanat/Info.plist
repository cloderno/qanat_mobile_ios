<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleDisplayName</key>
	<string>Qanat</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>kk</string>
		<string>en</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Скачанные письма и презентации видно в «Файлах» → «На iPhone» → Qanat (на Android — «Загрузки/Qanat»). -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Адрес сервера — из Config/*.xcconfig (QANAT_BASE_URL). -->
	<key>QanatBaseURL</key>
	<string>$(QANAT_BASE_URL)</string>

	<!-- Схема, по которой Meta AI возвращается в приложение при подключении очков. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>qanatmobile</string>
			</array>
		</dict>
	</array>

	<!-- Meta Wearables Device Access Toolkit. -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>qanatmobile://</string>
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>ClientToken</key>
		<string>$(CLIENT_TOKEN)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
		<!-- Телеметрию SDK в Meta не отправляем: политика обещает передавать данные только по необходимости. -->
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
		<key>CrashReporting</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>
	<!-- Установлен ли Meta AI: иначе «Открыть Meta AI» ведёт в App Store. Схема — предположение, проверить на устройстве. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>

	<!-- Фон: разговор с Канатом и голосовые с очков продолжаются при заблокированном экране (на Android — foreground service). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>

	<key>NSMicrophoneUsageDescription</key>
	<string>Микрофон нужен для голосовых сообщений и разговора с Канатом.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bluetooth нужен, чтобы подключиться к смарт-очкам Meta.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Так телефон находит очки и подключается к ним по Wi-Fi.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Снимки и видео с очков сохраняются в альбом «Qanat».</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Фото из галереи можно отправить Канату или поставить в профиль.</string>
	<key>NSCameraUsageDescription</key>
	<string>Камера нужна, чтобы сфотографировать документ для Каната.</string>

	<!-- Локальный сервер разработчика по http; внешние адреса — только https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>UIAppFonts</key>
	<array>
		<string>onest_regular.ttf</string>
		<string>onest_medium.ttf</string>
		<string>onest_semibold.ttf</string>
		<string>onest_bold.ttf</string>
		<string>unbounded_medium.ttf</string>
		<string>unbounded_semibold.ttf</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
